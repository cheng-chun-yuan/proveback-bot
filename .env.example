PORT=4100
# 對外網址。接 Recall.ai 時必須是公開 HTTPS(ngrok / Cloudflare Tunnel)
PUBLIC_URL=http://localhost:4100
# proveback-app 的位址,以及兩邊共用的密鑰(兩個 repo 要填一樣)
CONSOLE_URL=http://localhost:4000
SHARED_SECRET=change-me
BOT_NAME=ProveBack

# --- Recall.ai(留空 = 模擬會議室模式,開 /sim 測試)---
RECALL_API_KEY=
# us-east-1 / us-west-2 / eu-central-1 / ap-northeast-1,要跟你的 Recall 帳號區域一致
RECALL_REGION=us-west-2
# Recall webhook 網址上帶的 token,隨便一串亂數
WEBHOOK_TOKEN=change-me-too
